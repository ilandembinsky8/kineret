--- !u!114 &2238746329833850513
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4683524807971752556}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u05DE\u05D9\u05D3 \u05E0\u05EA\u05D7\u05D9\u05DC \u05D1\u05D7\u05D5\u05D5\u05D9\u05EA
    \u05D8\u05D9\u05E1\u05D4 \u05DE\u05D9\u05D5\u05D7\u05D3\u05EA \u05DE\u05E2\u05DC
    \u05E0\u05D5\u05E4\u05D9 \u05D4\u05DB\u05E0\u05E8\u05EA \u05D5\u05D4\u05D2\u05DC\u05D9\u05DC.\n\n\u05D1\u05DE\u05D4\u05DC\u05DA
    \u05D4\u05D8\u05D9\u05E1\u05D4 \u05D9\u05E9 \u05DC\u05E0\u05D5\u05D5\u05D8 \u05D1\u05D9\u05DF
    \u05D9\u05E2\u05D3\u05D9\u05DD \u05E9\u05DE\u05E7\u05D3\u05DE\u05D9\u05DD \u05D0\u05EA
    \u05E2\u05EA\u05D9\u05D3 \u05D4\u05E7\u05D9\u05D9\u05DE\u05D5\u05EA.\n<b>\u05E9\u05D9\u05DE\u05D5
    \u05DC\u05D1, \u05D6\u05D5\u05D4\u05D9 \u05EA\u05D7\u05E8\u05D5\u05EA!</b> \n\u05D1\u05D3\u05E8\u05DA
    \u05D0\u05DC \u05D4\u05D9\u05E2\u05D3\u05D9\u05DD \u05D9\u05E9 \u05DC\u05D0\u05E1\u05D5\u05E3
    \u05E0\u05E7\u05D5\u05D3\u05D5\u05EA \u05DE\u05D9\u05D3\u05E2 \u05D5\u05DC\u05DE\u05DC\u05D0
    \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D8\u05D9\u05E1\u05D4.\n \n\u05DB\u05E2\u05EA,
    <b>\u05E0\u05D0 \u05DC\u05D1\u05D7\u05D5\u05E8 \u05D1\u05D0\u05DE\u05E6\u05E2\u05D5\u05EA
    \u05D4\u05D2'\u05D5\u05D9\u05E1\u05D8\u05D9\u05E7 3 \u05D9\u05E2\u05D3\u05D9\u05DD
    \u05DB\u05DE\u05E1\u05DC\u05D5\u05DC \u05D4\u05D8\u05D9\u05E1\u05D4</b>  \u05DB\u05DE\u05E1\u05DC\u05D5\u05DC
    \u05D4\u05D8\u05D9\u05E1\u05D4 \u05E9\u05DC\u05DB\u05DD\n\u05DE\u05D9\u05D3 \u05D9\u05EA\u05D7\u05D9\u05DC
    \u05D4\u05E0\u05D9\u05D5\u05D5\u05D8 \u05D0\u05DC \u05D4\u05D9\u05E2\u05D3 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF"
  m_isRightToLeft: 1
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
