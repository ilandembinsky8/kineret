      "DestinationInfoScreenText": {
        "HebTitle": "צמח מ. טכנולוגיות חקלאיות – מחקר, בדיקות וניהול ידע לחקלאות מדויקת ובת-קיימא",
        "HebDescription": "צמח מפעילה מערך משולב של שירותי מעבדה, דיגום קרקע ומים, מחקר יישומי, וייעוץ אגרונומי מקצועי. באמצעות חוות מחקר פעילה ועשרות מחקרים שנתיים, החברה מפתחת שיטות גידול מותאמות אזור וזנים, מספקת ניטור מקצועי לצמצום סיכונים, ומשפרת את היעילות החקלאית. צמח מחברת בין נתונים, מחקר ושטח — כדי לאפשר חקלאות מדויקת, רווחית ועמידה לאורך זמן. 50+ שנות ניסיון כ-25 מומחים ISO 17025 – מעבדה מוסמכת מעבדות להשכרה במגוון אפשרויות חוות מחקר המשמשת פלטפורמה למחקרים ופיילוטים עבור חברות הזנק",
        "EngTitle": "",
        "EngDescription": ""
      },

      "FirstInfoPoint": {
        "HebTitle": "חוסר במחקר יישומי",
        "HebDescription": "כשאין מחקר יישומי שמחובר לשטח, מתקבלות החלטות על בסיס הנחות. התוצאה: ביצועים נמוכים, בזבוז משאבים, ושיטות גידול שלא מותאמות לאזור, לקרקע או לזן. טעויות כאלה אינן נקודתיות - הן פוגעות ברווחיות וביציבות החקלאית לשנים קדימה.",
        "EngTitle": "",
        "EngDescription": ""
      },
      "SecondInfoPoint": {
        "HebTitle": "חקלאות בחוסר ודאות",
        "HebDescription": "ללא בדיקות ומעקב שוטף אחר קרקע, מים, דשנים וחומר צמחי – החקלאות פועלת בעיניים עצומות. חוסר הוודאות פוגע בבריאות הקרקע, מגביר סיכונים, ומוביל לירידה בכמות ובאיכות היבול.",
        "EngTitle": "",
        "EngDescription": ""
      },
      "ThirdInfoPoint": {
        "HebTitle": "החלטות ללא דאטה",
        "HebDescription": "בלי ליווי אגרונומי ומערכת תומכת החלטה מבוססת נתונים, מתבזבזים מים ודשנים, הריסוס מופרז, ההשקיה לא מדויקת - וההוצאות עולות בזמן שהביצועים נשחקים.",
        "EngTitle": "",
        "EngDescription": ""
      }
