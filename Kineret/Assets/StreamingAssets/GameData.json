      "DestinationInfoScreenText": {
        "HebTitle": "מכון שמיר למחקר – מחקר יישומי רב־תחומי בלב הגולן",
        "HebDescription": "מכון שמיר למחקר הוא מרכז מחקר יישומי רב־תחומי המחבר בין מדע, תעשייה וצרכים אזוריים, ופועל בתחומי חקלאות, סביבה, מים, ביוטכנולוגיה ובריאות. באמצעות מעבדות מתקדמות ושיתופי פעולה רחבים, ודרך טורא – זרוע המסחור והיישום האחראית על הקמת חברות, ליווי סטארטאפים והטמעת טכנולוגיות – המכון הופך ידע מדעי לפתרונות מעשיים, מקדם חדשנות בת־קיימא ומחזק את הכלכלה והידע בפריפריה הצפונית.",
        "EngTitle": "",
        "EngDescription": ""
      },

      "FirstInfoPoint": {
        "HebTitle": "מחקר מדעי",
        "HebDescription": "מחקר מדעי מתקדם מתקשה לעיתים לעבור משלב המעבדה ליישום בשטח, ללא גוף שמתרגם ידע תיאורטי לפתרונות ישימים בתנאים אמיתיים.",
        "EngTitle": "",
        "EngDescription": ""
